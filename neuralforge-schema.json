{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeuralForge Configuration",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "description": "The base architecture model (e.g. yolo26n.pt, yolo26s.pt, yolov8n.pt, rt-detr)",
      "default": "yolo26n.pt"
    },
    "type": {
      "type": "string",
      "enum": ["yolo", "custom"],
      "description": "Training engine type (typically yolo)"
    },
    "train": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": ["detect", "segment", "classify", "obb", "pose"],
          "description": "Target computer vision task"
        },
        "data": {
          "type": "string",
          "description": "Path to dataset YAML file accessible by cluster invokers"
        },
        "epochs": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "time": {
          "type": "number",
          "description": "Optional max training duration in hours per trial"
        },
        "batch": {
          "type": "integer",
          "enum": [4, 8, 16, 32, 64],
          "default": 16
        },
        "imgsz": {
          "type": "integer",
          "default": 640
        }
      },
      "required": ["task", "data", "epochs"]
    },
    "post_train": {
      "type": "object",
      "description": "Post-training explainability and scientific analysis modules",
      "properties": {
        "xai": {
          "type": "boolean",
          "default": true,
          "description": "Generate Eigen-CAM / Grad-CAM heatmaps and Deletion AUC fidelity scores"
        },
        "adversarial": {
          "type": "boolean",
          "default": true,
          "description": "Evaluate adversarial robustness against FGSM/PGD perturbations"
        },
        "latex": {
          "type": "boolean",
          "default": true,
          "description": "Generate scientific LaTeX publication tables and reports"
        }
      }
    },
    "sweeper": {
      "type": "object",
      "description": "Optuna Sweeper v2 Hyperparameter Tuning Configuration",
      "properties": {
        "version": {
          "type": "integer",
          "default": 2
        },
        "study_name": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": ["maximize", "minimize"],
          "default": "maximize"
        },
        "fitness": {
          "type": "string",
          "default": "metrics/mAP50-95(B)"
        },
        "algorithm": {
          "type": "string",
          "enum": ["optuna"],
          "default": "optuna"
        },
        "sampler": {
          "type": "string",
          "enum": ["tpe", "cmaes"],
          "default": "tpe"
        },
        "tune": {
          "type": "boolean",
          "default": false
        },
        "n_trials": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "search_space": {
          "type": "object"
        }
      }
    },
    "start_at": {
      "type": "string",
      "description": "Optional scheduled start time (HH:MM or ISO timestamp)"
    },
    "target_worker": {
      "type": "string",
      "description": "Target worker node IP or private queue name (e.g. 192.168.1.68)"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "author": { "type": "string" },
        "documentation": { "type": "string" }
      }
    }
  },
  "required": ["model", "type", "train"]
}
