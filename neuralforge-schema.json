{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeuralForge Configuration",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "description": "El modelo base a utilizar (ej. yolov8n.pt, yolov8s.pt)",
      "default": "yolov8n.pt"
    },
    "type": {
      "type": "string",
      "enum": ["yolo", "custom"],
      "description": "Tipo de entrenamiento (usualmente yolo)"
    },
    "train": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": ["detect", "segment", "classify"],
          "description": "La tarea a resolver"
        },
        "data": {
          "type": "string",
          "description": "Ruta al archivo .yaml del dataset en el servidor"
        },
        "epochs": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "batch": {
          "type": "integer",
          "enum": [8, 16, 32, 64],
          "default": 16
        },
        "imgsz": {
          "type": "integer",
          "default": 640
        }
      },
      "required": ["task", "data", "epochs"]
    },
    "sweeper": {
      "type": "object",
      "description": "Configuración de Optuna (Auto-Tuning)",
      "properties": {
        "version": {
          "type": "integer",
          "default": 2
        },
        "study_name": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": ["maximize", "minimize"],
          "default": "maximize"
        },
        "fitness": {
          "type": "string",
          "default": "metrics/mAP50-95(B)"
        },
        "algorithm": {
          "type": "string",
          "enum": ["optuna"],
          "default": "optuna"
        },
        "tune": {
          "type": "boolean",
          "default": false
        },
        "n_trials": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "search_space": {
          "type": "object"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "author": { "type": "string" },
        "documentation": { "type": "string" }
      }
    }
  },
  "required": ["model", "type", "train"]
}
