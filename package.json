{
  "name": "neuralforge",
  "displayName": "NeuralForge Extension",
  "description": "VSCode extension for the NeuralForge train_service2 ecosystem",
  "version": "0.0.1",
  "publisher": "wisrovi",
  "icon": "media/icono.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neuralforge.viewClusterStatus",
        "title": "NeuralForge: View Cluster Status"
      },
      {
        "command": "neuralforge.launchTraining",
        "title": "NeuralForge: Launch Training"
      },
      {
        "command": "neuralforge.viewEDAReport",
        "title": "NeuralForge: View EDA Report"
      },
      {
        "command": "neuralforge.downloadTrialArtifacts",
        "title": "NeuralForge: Download Trial Artifacts (ZIP)"
      },
      {
        "command": "neuralforge.createConfigWizard",
        "title": "NeuralForge: Create Training Config (Wizard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neuralforge",
          "title": "NeuralForge",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "neuralforge": [
        {
          "id": "neuralforgeCluster",
          "name": "Cluster Status"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "neuralforge.launchTraining",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
