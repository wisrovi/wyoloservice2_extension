{
  "name": "neuralforge",
  "displayName": "NeuralForge AI: YOLO & Cluster MLOps Suite",
  "description": "Enterprise AI MLOps suite for distributed YOLO26/v8 training, Optuna hyperparameter optimization, real-time Celery/Kubernetes cluster monitoring, Explainable AI (Eigen-CAM heatmaps, Deletion AUC), and MLflow artifact management.",
  "version": "0.0.3",
  "publisher": "wisrovi",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisrovi/wyoloservice2_extension.git"
  },
  "icon": "media/icono.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "yolo",
    "yolo26",
    "neuralforge",
    "mlops",
    "optuna",
    "celery",
    "kubernetes",
    "xai",
    "eigen-cam",
    "grad-cam",
    "mlflow",
    "deep-learning",
    "computer-vision"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neuralforge.viewClusterStatus",
        "title": "NeuralForge: Refresh Cluster Telemetry & Node Health",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.launchTraining",
        "title": "NeuralForge: Launch Distributed YOLO Training Study",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.viewEDAReport",
        "title": "NeuralForge: View Exploratory Data Analysis (EDA) Report",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.downloadTrialArtifacts",
        "title": "NeuralForge: Download Complete Study Artifacts Bundle (ZIP)",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.createConfigWizard",
        "title": "NeuralForge: Open YOLO26 / Optuna Sweeper Configuration Wizard",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.local.viewLogs",
        "title": "NeuralForge (Local): Stream Invoker Worker Execution Logs",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.local.runTest",
        "title": "NeuralForge (Local): Run End-to-End Invoker Integration Test",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.global.viewReport",
        "title": "NeuralForge (Global): View Post-Train MLflow Executive Report",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.viewHeatmaps",
        "title": "NeuralForge (Global): Open XAI Heatmaps & Explainability Explorer",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.recommendNode",
        "title": "NeuralForge (Global): Query Best Compute Node for VRAM & Load",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.estimateDuration",
        "title": "NeuralForge (Global): Estimate Study Training Duration",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.downloadSelectiveArtifact",
        "title": "NeuralForge (Global): Selectively Download Specific MLflow Artifact",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.global.wpipeScaffold",
        "title": "NeuralForge (Global): Deploy WPipe Modular Pipeline Scaffolding",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.local.previewEDA",
        "title": "NeuralForge (Local): Preview Dataset Annotations (Mini-EDA)",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.global.celeryDashboard",
        "title": "NeuralForge (Global): Open Celery Mission Control Dashboard",
        "category": "NeuralForge"
      },
      {
        "command": "neuralforge.global.openCodeChat",
        "title": "NeuralForge (Global): Launch OpenCode AI Assistant Chat",
        "category": "NeuralForge"
      }
    ],
    "configuration": {
      "title": "NeuralForge AI",
      "properties": {
        "neuralforge.controlHost": {
          "type": "string",
          "default": "192.168.10.252",
          "description": "Host IP or hostname of the NeuralForge Manager / Control Server."
        },
        "neuralforge.controlPort": {
          "type": "number",
          "default": 23442,
          "description": "REST API port of the NeuralForge Control Server (default 23442)."
        },
        "neuralforge.k8sAdminPort": {
          "type": "number",
          "default": 30001,
          "description": "Kubernetes NodePort for the Cluster Admin API service (default 30001)."
        },
        "neuralforge.mlflowPort": {
          "type": "number",
          "default": 5000,
          "description": "Port of the MLflow Tracking Server for artifacts and experiment metrics (default 5000)."
        },
        "neuralforge.defaultModel": {
          "type": "string",
          "default": "yolo26n.pt",
          "description": "Default base architecture model for new configuration files."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neuralforge",
          "title": "NeuralForge AI",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "neuralforge": [
        {
          "id": "neuralforgeCluster",
          "name": "Cluster Infrastructure & Nodes (Global)"
        },
        {
          "id": "neuralforgeArtifacts",
          "name": "MLflow Models, XAI & Artifacts (Global)"
        },
        {
          "id": "neuralforgeLocal",
          "name": "Local Development & Invoker Tools"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": "*.yaml",
        "url": "./neuralforge-schema.json"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "neuralforge.launchTraining",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "install:all": "npm run --prefix . package && npx @vscode/vsce package --no-dependencies && code --install-extension neuralforge-0.0.3.vsix --force 2>/dev/null || true && antigravity --install-extension neuralforge-0.0.3.vsix --force 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
